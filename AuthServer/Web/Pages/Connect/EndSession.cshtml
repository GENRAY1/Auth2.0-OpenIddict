@page "/connect/logout"
@model AuthServer.Web.Pages.Connect.EndSessionModel
@using AuthServer.Web
@{ ViewData["Title"] = "Выход"; }

<h1>Выйти из аккаунта?</h1>

<form method="post" action="~/connect/logout">
    @Html.AntiForgeryToken()
    @foreach (var (name, value) in Model.Parameters)
    {
        <input type="hidden" name="@name" value="@value" />
    }
    <button type="submit" name="@ConnectRequest.LogoutField" value="1">Выйти</button>
</form>
