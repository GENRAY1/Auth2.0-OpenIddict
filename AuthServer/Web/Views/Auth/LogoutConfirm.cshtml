@model IReadOnlyList<KeyValuePair<string, string?>>
@{ ViewData["Title"] = "Выход"; }

<h1>Выйти из аккаунта?</h1>

<form method="post" action="~/connect/logout">
    @Html.AntiForgeryToken()
    @foreach (var (name, value) in Model)
    {
        <input type="hidden" name="@name" value="@value" />
    }
    <button type="submit" name="submit.Logout" value="1">Выйти</button>
</form>
